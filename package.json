{
  "name": "nucleo-marcus-jussier",
  "version": "0.1.0",
  "private": true,
  "description": "Protótipo de gestão de oficinas, cursos e eventos do Núcleo de Arte, Educação e Cultura Marcus Jussier",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/**",
    "check": "node scripts/check.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "express-session": "^1.19.0"
  }
}
